// Order model
model Order {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  name          String
  country       String
  streetAddress String
  city          String
  state         String
  zipCode       String
  phone         String
  email         String
  products      Json
  totalPrice    Float
  status        OrderStatus
  createdAt     DateTime    @default(now())

  trackingCode String?
  courierName  String?
  shippingCost Float   @default(0)
}

enum OrderStatus {
  Complete
  OrderPlaced
  Processing
  Shipped
  Delivered
  Canceled
  Return
  Pending
  Ordered
  Delete
}

// Define the PurchaseOrder model
model PurchaseOrder {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  poNo            String
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  supplierId      String    @db.ObjectId // MongoDB ObjectId reference to Supplier
  containerId     String?
  products        Json[] // {articleCode, name, quantity, order, mrp,tp,supplier}
  grn             Grn[]
  lcNo            String?
  piNo            String?
  totalItem       Int?
  total           Int?
  tax             Int?
  discount        Int?
  country         String?
  grossTotal      Int?
  grossTotalRound Int?
  note            String?

  status DataStatus
  user   User       @relation(fields: [userId], references: [id])
  userId String     @db.ObjectId // MongoDB ObjectId reference to User

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

