// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Admin model - dedicated single admin collection
model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  photo     String?
  phone     String?
  role      String   @default("admin")
  status    String   @default("active") // "active" | "inactive"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("Admin")
}

// Persistent setup-completion record for One-Time Admin Setup
model AdminSetupConfig {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  isSetupComplete Boolean  @default(true)
  completedAt     DateTime @default(now())
  adminEmail      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("AdminSetupConfig")
}

// user model
model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  email         String? // Optional email field
  phone         String          @unique
  name          String
  username      String?         @unique
  password      String
  type          AdminUserType // Enum for user type
  status        Status // Enum for user Status
  photo         String?
  warehouse     WareHouse?      @relation(fields: [warehouseId], references: [id])
  warehouseId   String?         @db.ObjectId // MongoDB ObjectId reference to User
  purchaseOrder PurchaseOrder[]
  grn           Grn[]
  tpn           Tpn[]
  sales         Sales[]
  damage        Damage[]
  adjust        Adjust[]
  userLogs      UserLogs[]

  // Define the relationship with products
  transactions       Transactions[] @relation("user")
  updateTransactions Transactions[] @relation("updateUser")
  answers            ProductAnswer[]

  @@index([phone, email, username])
}

// Customer model
model Customer {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  phone          String?           @unique
  email          String?
  photo          String?
  type           String
  password       String
  address        Json?
  company        String?
  walletBalance  Float             @default(0)
  status         Status            @default(Active)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customerId     String            @unique
  sales          Sales[]
  transactions   Transactions[]
  paymentMethods PaymentMethod[]
  reviews        Review[]
  conversations  Conversation[]
  vouchers       CustomerVoucher[]
  questions      ProductQuestion[]

  @@index([phone, password])
}

model PaymentMethod {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  type       String // e.g., "Card", "MFS", "COD"
  provider   String // e.g., "Visa", "Mastercard", "Bkash", "Nagad"
  lastFour   String? // Last 4 digits
  expiry     String? // MM/YY
  isDefault  Boolean  @default(false)
  customerId String   @db.ObjectId
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Coupon {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  code        String     @unique
  description String?
  discount    Float // Percentage or Fixed amount
  type        CouponType @default(Percentage)
  minAmount   Float?
  maxDiscount Float?
  expiryDate  DateTime
  status      Status     @default(Active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum CouponType {
  Percentage
  Fixed
}

// seller model
model Seller {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String   @unique
  email     String?
  photo     String?
  type      String
  password  String
  country   String?
  address   String?
  district  String?
  division  String?
  status    Status   @default(Active)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sellerId  String   @unique
  nidFront  String?
  nidBack   String?

  walletBalance  Float             @default(0)
  commissionRate Float             @default(10) // 10% default
  tier           String?           @default("Bronze")
  withdrawals    Withdrawal[]
  reviews        Review[]
  products       Product[]
  storeLimit     Int               @default(5)
  stores         Store[]
  conversations  Conversation[]
  escrowHoldings EscrowHolding[]
  escrowLedgers  EscrowLedger[]
  answers        ProductAnswer[]

  @@index([password, phone])
}

// store setup model
model Store {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String   @db.ObjectId
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  storeNameBn String
  storeNameEn String
  storeName   String // Fallback compatibility
  slug        String   @unique
  description String?
  phone       String
  email       String
  storeLogo   String?
  storeBanner String?
  followerIds String[] @db.ObjectId

  // Banner Customizations
  bannerTitle   String?
  bannerDesc    String?
  bannerBtnText String?
  bannerBtnUrl  String?

  status          StoreStatus @default(Pending)
  rejectionReason String?

  // Category
  masterCategoryId String   @db.ObjectId
  masterCategory   Category @relation(fields: [masterCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Location/Socials
  address   String?
  facebook  String?
  instagram String?
  x         String?

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings        StoreSettings?
  paymentSettings StorePaymentSettings?

  products         Product[]
  featuredProducts StoreFeaturedProduct[]
  conversations    Conversation[]

  @@index([sellerId])
}

model Supplier {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  phone         String
  email         String
  address       String
  company       String
  country       String
  description   String
  designation   String
  status        Status          @default(Active)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // product     Product[]
  Product       Product[]
  grn           Grn[]
  purchaseOrder PurchaseOrder[]
  tpn           Tpn[]
}

//Product Model
model Product {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String?
  specification    String?
  masterCategory   Category? @relation(fields: [masterCategoryId], references: [id], name: "masterCategory")
  masterCategoryId String?   @db.ObjectId
  articleCode      String?   @default("")
  category         Category? @relation(fields: [categoryId], references: [id], name: "category")
  categoryId       String?   @db.ObjectId
  photo            Json?
  video            String?
  brand            Brand?    @relation(fields: [brandId], references: [id])
  brandId          String?   @db.ObjectId
  model            String    @default("")
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  supplierId       String?   @db.ObjectId
  seller           Seller?   @relation(fields: [sellerId], references: [id])
  sellerId         String?   @db.ObjectId
  color            String?
  picsInPackage    Float?
  weight           Float?
  unit             Unit?     @relation(fields: [unitId], references: [id])
  unitId           String    @db.ObjectId
  salesType        SalesType @default(Standerd)
  hsCode           String?
  featured         String?   @default("false")
  website          String?   @default("false")
  price            Float     @default(0)
  mrp              Float?
  tp               Float?
  ean              String    @default("")
  vat              Float?
  vatMethod        String?   @default("false")
  openingQty       Int       @default(0)
  soldQty          Int       @default(0)
  availableQty     Int       @default(0)
  closingQty       Int       @default(0)
  returnQty        Int       @default(0)
  grnQty           Int       @default(0)
  rcvAdjustQty     Int       @default(0)
  issueAdjustQty   Int       @default(0)
  damageQty        Int       @default(0)
  tpnQty           Int       @default(0)
  rtvQty           Int       @default(0)
  stock            Float     @default(1)
  cogs             Float?    @default(0)
  shipping         String?
  promoPrice       Float?
  status           Status    @default(Active)
  promoStart       DateTime?
  promoEnd         DateTime?
  description      String?
  highlight        String?
  variants         Json?
  dimensions       Json?
  dangerousGoods   String?
  hasVariants      Boolean?  @default(false)
  reviews          Review[]
  averageRating    Float     @default(0)
  reviewCount      Int       @default(0)

  storeId         String?                @db.ObjectId
  store           Store?                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  featuredInStore StoreFeaturedProduct[]

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  CampaignProduct  CampaignProduct[]
  FlashSaleProduct FlashSaleProduct[]
  questions        ProductQuestion[]
  variantsList     ProductVariant[]
  stockLedger      StockLedger[]

  @@index([name])
}

// Define the Category model
model Category {
  id             String     @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  name           String
  description    String?
  code           String     @unique
  status         String
  photo          String?
  parent         Category?  @relation("subcategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId       String?    @db.ObjectId
  products       Product[]  @relation("category")
  masterProducts Product[]  @relation("masterCategory")
  subcategories  Category[] @relation("subcategories")
  stores         Store[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// Define the Brand model
model Brand {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  name        String
  description String?
  code        String? @unique
  status      String
  logo        String? // Assuming logo is stored as a URL

  // Define the relationship for products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Define the Unit model
model Unit {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId // MongoDB ObjectId
  name        String
  description String?
  code        String  @unique
  status      String
  symbol      String

  // Define the relationship for products
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

