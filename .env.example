# Environment Variables Example for Bangla Bazar
# Do NOT place real secrets in this file. Copy to .env for local development.

# Database Connection (MongoDB)
DATABASE_URL=
MONGODB_URI=

# NextAuth Configuration
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Initial Admin Password (for seed:admin script)
ADMIN_PASSWORD=

# Secure One-Time Setup Token (Required for initializing the Admin via /admin/setup)
ADMIN_SETUP_TOKEN=

# SMS Gateway (Optional)
SMS_GATEWAY=

# Payment Gateways (Optional)
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
